{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FUDE",
  "version": "0.1.0",
  "identifier": "ru.fude.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FUDE 筆",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "backgroundColor": "#F3EEE4"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../lessons/": "lessons/" },
    "category": "Education",
    "shortDescription": "Уроки цифрового рисунка в редакторе PhotoCraft",
    "copyright": "© 2026 SelfKnowledge, MIT"
  }
}
